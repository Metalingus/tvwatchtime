# TV Watch Time server configuration.
#
# `bash scripts/selfhost.sh setup` copies this file to .env.prod and fills in tier 1 for you.
# docs/SELF_HOSTING.md#configuration explains each setting: what it gives you and how to turn it on.
# After editing .env.prod, apply the change with: bash scripts/selfhost.sh update
#
# Tiers:  1 REQUIRED · 2 RECOMMENDED · 3 OPTIONAL · 4 ADVANCED (leave as is unless you know why)


# ═════════════════════════════════════════════════════════════════════════════════════════════════
# 1. REQUIRED. The server doesn't start, or isn't reachable, without these.
# ═════════════════════════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
# Keep "log": without email (SMTP), password-reset links are written to the log at this level.
LOG_LEVEL=log

# How the server is reached. Read by docker compose, so always pass --env-file .env.prod.
#   domain: HTTPS on api./admin./s3. subdomains of TVWATCH_DOMAIN. Works with the phone apps.
#   local:  plain HTTP on a home-network address, no domain (web browsers only). Also loads
#           docker-compose.local.yml; scripts/selfhost.sh adds it for you.
TVWATCH_MODE=domain
TVWATCH_DOMAIN=example.com
# Home-network mode only: the address browsers use, and the published ports.
TVWATCH_LOCAL_URL=
TVWATCH_HTTP_PORT=
TVWATCH_ADMIN_PORT=

# Public addresses. Domain mode: https://api.<domain>. Home-network mode: TVWATCH_LOCAL_URL.
# API_BASE_URL never ends in /api; avatar links are built from it.
API_BASE_URL=https://api.example.com
API_PORT=4000
# Every browser origin that calls the API: the bare domain (password-reset page), the admin
# console, and your own web app build. (The phone apps don't need an entry.)
CORS_ORIGINS=https://example.com,https://admin.example.com,https://app.example.com
# Where password-reset and account-deletion links point (the bare domain serves those pages).
SITE_URL=https://example.com

# The first account registered with this email becomes the super admin.
BOOTSTRAP_SUPER_ADMIN_EMAIL=you@example.com

# TMDb: all show/movie information, search, and artwork. Free key (use the short "API Key"):
# https://www.themoviedb.org/settings/api. Set it here; the admin Settings page can't replace it.
TMDB_API_KEY=

# Secrets. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
# Encrypts connected-service credentials and comment images. Back it up; it can't be recovered.
ENCRYPTION_MASTER_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# Database
POSTGRES_USER=tvwatch
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tvwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Same password as above. URL-encode special characters (hex passwords need none):
#   + → %2B, / → %2F, = → %3D, @ → %40, # → %23
DATABASE_URL=postgresql://tvwatch:CHANGE_ME_STRONG_PASSWORD@postgres:5432/tvwatch?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Storage (MinIO). S3_SECRET_ACCESS_KEY must equal MINIO_ROOT_PASSWORD.
MINIO_ROOT_USER=tvwatch
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tvwatch
S3_SECRET_ACCESS_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
# Public URL of the avatar bucket. Domain mode: https://s3.<domain>/tvwatch-user-images.
# Home-network mode: <TVWATCH_LOCAL_URL>/tvwatch-user-images. Never http://minio:9000.
S3_PUBLIC_BASE_URL=https://s3.example.com/tvwatch-user-images


# ═════════════════════════════════════════════════════════════════════════════════════════════════
# 2. RECOMMENDED. Free, and each one makes the app noticeably better.
# ═════════════════════════════════════════════════════════════════════════════════════════════════

# TheTVDB: search covers TheTVDB as well as TMDb (more shows), anime and other TVDB-tracked shows
# use its episode lists, an hourly job picks up new episodes and air dates, and character votes
# get character photos.
# Key: https://thetvdb.com/api-information. TVDB_PIN only for keys tied to a user subscription.
TVDB_API_KEY=
# TVDB_PIN=

# Movie of the Night: the "Top on Netflix / Prime Video / Disney+ / Apple TV / HBO Max today" rows
# in Explore. Free plan: 1000 requests/month. Key: https://www.movieofthenight.com/about/api
# Then turn it on: Admin console → Auto Hydrations → "Streaming Top Charts" → enable, and pick
# up to 6 countries and the services.
MOTN_API_KEY=

# Phone push notifications. The official apps can only receive pushes through the public relay
# (rate-limited per device). Use PUSH_MODE=expo with EXPO_ACCESS_TOKEN only for your own app build.
PUSH_MODE=relay
PUSH_RELAY_URL=https://api.tvwatchtime.org/api
EXPO_ACCESS_TOKEN=

# Browser notifications for the web app (domain mode only; browsers require HTTPS). Setup generates
# these. By hand: docker run --rm node:20-alpine npx -y web-push@3.6.7 generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email, for password-reset and account-deletion emails. Without it, use
# `bash scripts/selfhost.sh reset-password` (the link is also written to the API log).
SMTP_HOST=
SMTP_PORT=587
# true for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com


# ═════════════════════════════════════════════════════════════════════════════════════════════════
# 3. OPTIONAL. Only if you want the specific feature.
# ═════════════════════════════════════════════════════════════════════════════════════════════════

# SIMKL sync (Stremio, Jellyfin, Plex, and Emby need no key). Create an app at https://simkl.com/settings/developer/
SIMKL_CLIENT_ID=
SIMKL_APP_NAME=tvwatch
SIMKL_APP_VERSION=0.1.0

# Allow Jellyfin, Plex, and Emby servers on private addresses (192.168.x.x, 10.x.x.x).
# Needed when your media server is on your home network. Home-network mode sets it to true.
ALLOW_PRIVATE_INTEGRATION_URLS=false

# OpenAI moderation of comment text and images. Useful only if other people post comments.
# Note: while OpenAI is unreachable, posting comments fails instead of skipping the check.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Microsoft Azure Translator: a "Translate" button on comments and reviews. Needs key AND region.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# WatchForge: extra ID matching for difficult imports. Needs an approved developer key from
# https://api.watchforge.app/; most self-hosters can skip it.
WATCHFORGE_API_KEY=
# Optional cap below the account's daily limit.
# WATCHFORGE_REQUESTS_PER_DAY=


# ═════════════════════════════════════════════════════════════════════════════════════════════════
# 4. ADVANCED. The defaults are fine for a personal server.
# ═════════════════════════════════════════════════════════════════════════════════════════════════

# Sign-in sessions
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Social login works only with your own app build (the official apps hide it for self-hosted
# servers). Leave all blank otherwise. APPLE_CLIENT_ID requires the other three APPLE_ values in
# production, or the API refuses to start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the .p8 content with escaped newlines, or set APPLE_PRIVATE_KEY_PATH instead.
APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple-sign-in-key.p8

# Per-user limits. Imports per user per day are set in Admin console → Settings → Rate Limits.
MAX_PUSH_NOTIFICATIONS_PER_USER_PER_DAY=3
MAX_COMMENT_IMAGE_UPLOAD_MB=5
COMMENT_IMAGE_UPLOADS_PER_USER_PER_DAY=20

# Hour (in each user's own time zone) when the first episode notification of the day is sent.
NOTIFICATION_SPREAD_START_HOUR=12

# Media-server sync job: accounts per run and hours between syncs of one account.
INTEGRATION_SYNC_BATCH_SIZE=25
INTEGRATION_SYNC_STALE_HOURS=6

# Metadata jobs
# Default "Shows per run" of the hourly TVDB schedule refresh job (1-1000).
TVDB_SCHEDULE_REFRESH_BATCH_SIZE=100
# Automatic cross-media canonicalization after hydration.
STRUCTURE_REPAIR_ENABLED=false
# Provider request rates (defaults: TMDb 40/s; TVDB 2/s, 60/min, 2 at a time).
# TMDB_REQUESTS_PER_SECOND=40
# TVDB_REQUESTS_PER_SECOND=2
# TVDB_REQUESTS_PER_MINUTE=60

# Storage bucket names
S3_BUCKET=tvwatch-media
S3_BUCKET_COMMENT_IMAGES=tvwatch-comment-images
S3_BUCKET_TEMP_UPLOADS=tvwatch-temp-uploads

# This server's own push relay endpoint, for other servers. Self-hosters leave it off.
PUSH_RELAY_ENABLED=false
PUSH_RELAY_RATE_LIMIT=10
PUSH_RELAY_RATE_WINDOW_MINUTES=10

# Performance (safe for a 2 GB server; raise on bigger hardware)
DATABASE_CONNECTION_LIMIT=20
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=4MB
IMPORT_WORKER_CONCURRENCY=2
IMPORT_MATCH_CONCURRENCY=8
COMMENT_IMAGE_WORKER_CONCURRENCY=2
LEADERBOARD_USER_REFRESH_DELAY_MS=2000
LEADERBOARD_REBUILD_LOCK_TTL_SEC=600
PERSONALIZATION_CACHE_TTL_SEC=1800
