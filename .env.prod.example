NODE_ENV=production

LOG_LEVEL=log

# Database
POSTGRES_USER=tvwatch
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tvwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Required for the Prisma CLI (prisma migrate deploy). URL-encode special chars in password:
#   + → %2B, / → %2F, = → %3D, @ → %40, # → %23
DATABASE_URL=postgresql://tvwatch:CHANGE_ME_STRONG_PASSWORD@postgres:5432/tvwatch?schema=public

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Optional: set REDIS_URL instead of host/port if you prefer URL format
# REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# API
API_PORT=4000
API_BASE_URL=https://api.example.com
# Admin console + every web origin that talks to this API. Keep https://app.tvwatchtime.org if
# you want to use the hosted web app with your server; add your own app subdomain if you host one.
CORS_ORIGINS=https://admin.example.com,https://app.example.com,https://app.tvwatchtime.org

# Auth
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BOOTSTRAP_SUPER_ADMIN_EMAIL=you@example.com

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=tvwatch
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=tvwatch-media
S3_BUCKET_COMMENT_IMAGES=tvwatch-comment-images
S3_BUCKET_TEMP_UPLOADS=tvwatch-temp-uploads
S3_ACCESS_KEY_ID=tvwatch
S3_SECRET_ACCESS_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
# Public HTTPS URL of the user-images bucket (served by Caddy at s3.<domain>). Never http://minio:9000.
S3_PUBLIC_BASE_URL=https://s3.example.com/tvwatch-user-images

# Encryption
ENCRYPTION_MASTER_KEY=CHANGE_ME_32_BYTE_HEX_KEY

# TMDb
TMDB_API_KEY=
TMDB_LANGUAGE=en-US

# Inbound integrations
# Register an API client at SIMKL; leave blank to hide SIMKL connection.
SIMKL_CLIENT_ID=
SIMKL_APP_NAME=tvwatch
SIMKL_APP_VERSION=0.1.0
# Production defaults to public HTTPS Jellyfin servers only. Enable only for trusted self-hosted networks.
ALLOW_PRIVATE_INTEGRATION_URLS=false
# The scheduled job selects at most this many stale Stremio/Jellyfin accounts per run.
INTEGRATION_SYNC_BATCH_SIZE=25
# Connected accounts become eligible for scheduled refresh after this many hours.
INTEGRATION_SYNC_STALE_HOURS=6

# TVmaze
# Retired: this flag is ignored; TVmaze cannot be re-enabled.
TVMAZE_ENABLED=false
TVMAZE_API_KEY=

# TVDB (optional — adds more shows to search, larger database)
# Optional WatchForge identity lookup (developer key; never sent to mobile)
WATCHFORGE_API_KEY=
# Optional cap below the account limit reported by WatchForge /me (leave unset to follow the account tier).
# WATCHFORGE_REQUESTS_PER_DAY=

# Optional Movie of the Night streaming top charts (free plan: 1000 requests/month hard cap).
# Countries and services are set on the Streaming Top Charts row in Admin → Scheduled Hydrations.
MOTN_API_KEY=
# MOTN_ENABLED=true
# MOTN_REQUESTS_PER_SECOND=1

TVDB_API_KEY=

# Automatic cross-media canonicalization after hydration stays off unless explicitly enabled.
STRUCTURE_REPAIR_ENABLED=false
# Default "Shows per run" of the hourly TVDB schedule refresh job (1-1000).
TVDB_SCHEDULE_REFRESH_BATCH_SIZE=100

# OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=app.tvwatchtime.mobile
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Store the .p8 content with escaped newlines, or set APPLE_PRIVATE_KEY_PATH instead.
APPLE_PRIVATE_KEY=
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple-sign-in-key.p8

# Push
# Self-hosted servers used with the public TV Watch Time app: relay pushes through the public
# server (rate-limited per device). Use PUSH_MODE=expo + EXPO_ACCESS_TOKEN only with your own app
# build, or PUSH_MODE=none to keep in-app notifications only.
PUSH_MODE=relay
PUSH_RELAY_URL=https://api.tvwatchtime.org/api
EXPO_ACCESS_TOKEN=
# Mounts this server's own relay endpoint for other instances; self-hosters can leave it off.
PUSH_RELAY_ENABLED=false
PUSH_RELAY_RATE_LIMIT=10
PUSH_RELAY_RATE_WINDOW_MINUTES=10

# Web Push (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# OpenAI Moderation (leave blank to skip moderation)
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Microsoft Azure Translator (leave blank to disable new comment/review translations)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Email (for data deletion requests) — leave blank to disable email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Limits
IMPORT_DAILY_LIMIT=10
MAX_PUSH_NOTIFICATIONS_PER_USER_PER_DAY=3
MAX_COMMENT_IMAGE_UPLOAD_MB=5
COMMENT_IMAGE_UPLOADS_PER_USER_PER_DAY=20

# Performance tuning (defaults are safe for small servers — increase for larger hardware)

# Database connections (Prisma pool size)
DATABASE_CONNECTION_LIMIT=20

# Postgres tuning (set shared_buffers to ~25% of RAM)
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_CACHE_SIZE=1GB
POSTGRES_WORK_MEM=4MB

# External API rate limits (0 = unlimited, automatic backoff on 429)
TMDB_RPS=0
TVDB_RPS=0

# Background workers
IMPORT_WORKER_CONCURRENCY=2
IMPORT_MATCH_CONCURRENCY=8
COMMENT_IMAGE_WORKER_CONCURRENCY=2
# Debounce repeated watch/import mutations before refreshing one user's Redis leaderboard scores.
LEADERBOARD_USER_REFRESH_DELAY_MS=2000
# Distributed lock TTL for the cold/recovery-only full leaderboard initialization.
LEADERBOARD_REBUILD_LOCK_TTL_SEC=600
# Last-good personalized rankings remain available while their replacement is computed.
PERSONALIZATION_CACHE_TTL_SEC=1800

# Notifications
NOTIFICATION_SPREAD_START_HOUR=12

# Public site URL (used for data deletion + password reset email links)
SITE_URL=https://example.com

# Note: GIPHY API keys for the mobile GIF picker live in apps/mobile/app.json
# under expo.extra (giphyApiKeyAndroid|Ios|Web), not here. See docs/ENVIRONMENT.md.
