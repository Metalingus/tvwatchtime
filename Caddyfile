{$TVWATCH_DOMAIN:tvwatchtime.org} {
  @tv_time_aliases path /tv-time/ /tv-time.html /tv-time-alternative /tv-time-alternative/ /tv-time-alternative.html
  redir @tv_time_aliases /tv-time 308

  root * /srv/public-site
  try_files {path} {path}.html /index.html
  file_server
}

app.{$TVWATCH_DOMAIN:tvwatchtime.org} {
  root * /srv/app-web
  try_files {path} /index.html
  file_server
}

api.{$TVWATCH_DOMAIN:tvwatchtime.org} {
  reverse_proxy api:4000
}

admin.{$TVWATCH_DOMAIN:tvwatchtime.org} {
  reverse_proxy admin:3000
}

s3.{$TVWATCH_DOMAIN:tvwatchtime.org} {
  reverse_proxy minio:9000
}
