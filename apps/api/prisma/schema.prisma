// ---------------------------------------------------------------------------
// ADMIN
// ---------------------------------------------------------------------------

enum HydrationJobType {
  trending_shows
  trending_movies
  trending_all
  popular_shows
  popular_movies
  top_rated_shows
  top_rated_movies
  upcoming_movies
  now_playing_movies
  airing_today
  on_the_air
  single_show
  single_movie
  missing_data
  stale_refresh
  full_refresh
}

enum HydrationJobStatus {
  queued
  running
  completed
  failed
  cancelled
  paused
}

model HydrationJob {
  id             String             @id @default(cuid())
  type           HydrationJobType   @map("type")
  status         HydrationJobStatus @default(queued)
  triggeredBy    String             @map("triggered_by")
  totalItems     Int                @default(0) @map("total_items")
  processedItems Int                @default(0) @map("processed_items")
  failedItems    Int                @default(0) @map("failed_items")
  skippedItems   Int                @default(0) @map("skipped_items")
  tmdbApiCalls   Int                @default(0) @map("tmdb_api_calls")
  // Multi-provider generalization (Migration B). Backfilled: provider='TMDB', matchStage='hydrate'.
  provider       String?
  entityKind     String?            @map("entity_kind")
  locale         String?
  matchStage     String?            @map("match_stage") // candidate | match | hydrate | rehydrate
  providerCalls  Json?              @map("provider_calls") // { tmdb: n, tvdb: n, kitsu: n, jikan: n }
  errorMessage   String?            @map("error_message")
  currentItem    String?            @map("current_item")
  /// Completed scheduled catalog hydrations can serve as ordered Explore rail snapshots.
  railSnapshot   Boolean            @default(false) @map("rail_snapshot")
  startedAt      DateTime?          @map("started_at")
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  items HydrationJobItem[]

  @@index([status])
  @@index([type])
  @@index([type, railSnapshot, status, completedAt])
  @@map("hydration_jobs")
}

model HydrationJobItem {
  id                 String    @id @default(cuid())
  jobId              String    @map("job_id")
  tmdbId             Int       @map("tmdb_id")
  mediaType          String    @map("media_type")
  status             String    @default("pending")
  mediaId            String?   @map("media_id")
  /// One-based provider rank within a scheduled Explore rail refresh.
  rank               Int?
  // Multi-provider identity (Migration B): for non-TMDB/identity-keyed items.
  provider           String?
  providerEntityKind String?   @map("provider_entity_kind")
  externalIdValue    String?   @map("external_id_value")
  errorMessage       String?   @map("error_message")
  processedAt        DateTime? @map("processed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  job HydrationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, status, rank])
  @@map("hydration_job_items")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  encrypted Boolean  @default(false)
  category  String   @default("general")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Announcement {
  id           String    @id @default(cuid())
  revision     Int       @default(1)
  icon         String    @default("information-circle-outline")
  // per-locale text, JSON: { en: "...", fr: "...", ... }. `en` required.
  title        Json
  message      Json
  actionLabel  Json?     @map("action_label")
  actionType   String    @default("none") @map("action_type") // none | navigate | external
  actionTarget String?   @map("action_target")
  actionParams Json?     @map("action_params")
  placement    String    @default("shows")
  active       Boolean   @default(false)
  alsoPush     Boolean   @default(false) @map("also_push")
  pushSentAt   DateTime? @map("push_sent_at")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([active])
  @@map("announcements")
}

model Broadcast {
  id              String               @id @default(cuid())
  title           Json
  body            Json?
  category        NotificationCategory @default(ANNOUNCEMENT)
  actionType      String?              @map("action_type")
  actionTarget    String?              @map("action_target")
  actionParams    Json?                @map("action_params")
  inApp           Boolean              @default(false) @map("in_app")
  totalRecipients Int                  @default(0) @map("total_recipients")
  sentCount       Int                  @default(0) @map("sent_count")
  failedCount     Int                  @default(0) @map("failed_count")
  status          String               @default("queued") // queued | running | completed | failed
  startedAt       DateTime?            @map("started_at")
  completedAt     DateTime?            @map("completed_at")
  error           String?
  createdBy       String               @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([status])
  @@map("broadcasts")
}

model ContactThread {
  id            String              @id @default(cuid())
  userId        String              @map("user_id")
  reason        ContactReason
  subject       String
  status        ContactThreadStatus @default(OPEN)
  adminReplied  Boolean             @default(false) @map("admin_replied")
  userReadAt    DateTime?           @map("user_read_at")
  adminReadAt   DateTime?           @map("admin_read_at")
  closedAt      DateTime?           @map("closed_at")
  closedBy      String?             @map("closed_by")
  lastMessageAt DateTime            @default(now()) @map("last_message_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  user     User             @relation("ContactThreads", fields: [userId], references: [id], onDelete: Cascade)
  messages ContactMessage[]

  @@index([userId])
  @@index([status])
  @@index([lastMessageAt])
  @@map("contact_threads")
}

model ContactMessage {
  id         String               @id @default(cuid())
  threadId   String               @map("thread_id")
  authorRole ContactMessageAuthor @map("author_role")
  authorId   String               @map("author_id")
  body       String               @db.Text
  createdAt  DateTime             @default(now()) @map("created_at")

  thread ContactThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("contact_messages")
}

model CronJob {
  id             String    @id @default(cuid())
  name           String    @unique
  label          String
  schedule       String
  /// IANA timezone for the schedule (null = server default).
  timezone       String?
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  lastStatus     String?   @map("last_status")
  lastError      String?   @map("last_error")
  lastDurationMs Int?      @map("last_duration_ms")
  runs           Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  history CronJobRun[]

  @@map("cron_jobs")
}

model CronJobRun {
  id         String   @id @default(cuid())
  jobId      String   @map("job_id")
  status     String
  error      String?
  /// Outcome summary of the run (counts/result payload), when the handler returns one.
  result     Json?
  durationMs Int      @map("duration_ms")
  startedAt  DateTime @map("started_at")
  finishedAt DateTime @map("finished_at")

  job CronJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("cron_job_runs")
}

model ScheduledHydration {
  id        String    @id @default(cuid())
  type      String
  label     String
  schedule  String
  /// IANA timezone for the schedule (null = server default).
  timezone  String?
  pages     Int       @default(1)
  enabled   Boolean   @default(false)
  lastRunAt DateTime? @map("last_run_at")
  lastJobId String?   @map("last_job_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("scheduled_hydrations")
}

model DeletionRequest {
  id        String    @id @default(cuid())
  email     String
  userId    String?   @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@map("deletion_requests")
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  userId    String?   @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_resets")
}

model DataExport {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  token       String   @unique
  fileName    String   @map("file_name")
  contentType String   @default("application/json") @map("content_type")
  /// Compressed export bytes are kept in PostgreSQL so a download can be served by
  /// any API replica. Null is retained for legacy filesystem-backed exports.
  payload     Bytes?
  status      String   @default("pending")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("data_exports")
}
