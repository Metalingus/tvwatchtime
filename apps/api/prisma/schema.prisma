model Badge {
  id              String         @id @default(cuid())
  category        BadgeCategory
  name            String         @unique
  description     String         @db.Text
  icon            String
  iconColor       String?        @map("icon_color")
  scopeType       BadgeScopeType @default(GLOBAL) @map("scope_type")
  scopeMediaId    String?        @map("scope_media_id")
  unlockCondition String         @map("unlock_condition")
  threshold       Int?
  createdAt       DateTime       @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  badgeId    String    @map("badge_id")
  unlocked   Boolean   @default(false)
  unlockedAt DateTime? @map("unlocked_at")
  current    Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
