// TVWatchTime — source of truth data model
// Conventions: snake_case DB columns via @map, camelCase in TS.
// Regenerate after edits: pnpm db:generate

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  USER
  VIEWER
  SUPPORT
  CONTENT_MANAGER
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
  EMAIL
}

enum MediaType {
  SHOW
  MOVIE
}

enum MediaStatus {
  RETURNING
  ENDED
  UPCOMING
  CANCELED
}

enum ExternalProvider {
  TMDB
  TVMAZE
  IMDB
  TRAKT
  THE_TVDB
  KITSU
  MYANIME_LIST
}

// Namespace within a provider's id space. A verified identity is the triple
// (provider, providerEntityKind, value). Avoids collisions such as TMDB series vs
// movie ids, TVDB series vs movie vs episode ids, Kitsu/MAL anime vs manga ids.
// Backfilled for existing media-level rows from MediaItem.type.
enum ProviderEntityKind {
  SERIES
  MOVIE
  EPISODE
  SEASON
  ANIME
  MANGA
}

// Content classification, independent of structural media type (SHOW/MOVIE).
enum ContentClassification {
  GENERAL
  ANIME
  MANGA
  UNKNOWN
}

// Canonical provider for a show's active season/episode graph. External aliases from
// both providers may coexist on an active episode; only this provider may create or
// update structural rows outside an explicit remap.
enum StructureProvider {
  TMDB
  TVDB
}

enum MediaCanonicalRelation {
  EXACT_DUPLICATE
  SEASON_COMPONENT
}

enum MediaCanonicalStatus {
  COPYING
  ACTIVE
  FAILED
}

enum StructureReason {
  GENERAL_TMDB
  GENERAL_TVDB
  ANIME_TVDB
  TVDB_ONLY_FALLBACK
  MANUAL_OVERRIDE
}

enum EpisodeStructureState {
  ACTIVE
  LEGACY_UNMAPPED
}

enum WatchDevice {
  PHONE
  TABLET
  COMPUTER
  TV
  OTHER
}

enum ReactionType {
  SHOCKED
  FRUSTRATED
  SAD
  REFLECTIVE
  TOUCHED
  AMUSED
  SCARED
  BORED
  UNDERSTANDING
  THRILLED
  CONFUSED
  TENSE
}

enum NotificationCategory {
  EPISODE_SOON
  EPISODE_TODAY
  EPISODE_AIRED
  PREMIERE
  MOVIE_RELEASE
  WATCHLIST_REMINDER
  PROVIDER_ALERT
  BADGE
  FOLLOW
  COMMENT_LIKE
  COMMENT_REPLY
  SYSTEM
  ANNOUNCEMENT
  CONTACT
}

enum NotificationChannel {
  IN_APP
  PUSH
  BOTH
}

enum NotificationTiming {
  AT_RELEASE
  M15_BEFORE
  H1_BEFORE
  D1_BEFORE
  WEEKLY_DIGEST
}

enum NotificationSort {
  MOST_RELEVANT
  LATEST
  MOST_LIKED
}

enum PushJobStatus {
  QUEUED
  SCHEDULED
  DISPATCHED
  DELIVERED
  FAILED
  SKIPPED
}

enum ContactReason {
  FEEDBACK
  BUG_REPORT
  DATA
  PERSONAL_INFO
  ACCOUNT
  OTHER
}

enum ContactThreadStatus {
  OPEN
  CLOSED
}

enum ContactMessageAuthor {
  USER
  ADMIN
}

enum BadgeCategory {
  WATCH
  MARATHON
  APP_USAGE
  RATING
  COMMENT
  FOLLOW
}

enum BadgeScopeType {
  GLOBAL
  SHOW
  MOVIE
}

enum ListVisibility {
  PRIVATE
  PUBLIC
}

enum ListSource {
  MANUAL
  TVTIME
  TRAKT
}

enum ImportStatus {
  UPLOADED
  QUEUED
  EXTRACTING
  PARSING
  NORMALIZING
  MATCHING
  READY_FOR_REVIEW
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
  ROLLED_BACK
}

enum ImportItemStatus {
  MATCHED
  UNMATCHED
  DUPLICATE
  CONFLICT
  INVALID
  NEEDS_REVIEW
  SKIPPED
  APPLIED
  /// Queued for background re-matching (e.g. TVDB rehydration for character votes) —
  /// applied by a later confirm once the background work completes.
  PENDING_MATCH
}

enum ImportEntityType {
  WATCHED_EPISODE
  WATCHED_MOVIE
  WATCHLIST_SHOW
  WATCHLIST_MOVIE
  FAVORITE_SHOW
  FAVORITE_MOVIE
  SHOW_RATING
  EPISODE_RATING
  MOVIE_RATING
  EPISODE_EMOTION
  MOVIE_EMOTION
  EPISODE_COMMENT
  MOVIE_COMMENT
  SHOW_COMMENT
  EPISODE_CHARACTER_VOTE
  MOVIE_CHARACTER_VOTE
  LIST
  LIST_ITEM
  UNKNOWN
}

enum ImportSourceType {
  zip
  csv
  json
}

enum ImportAppliedAction {
  created
  updated
  skipped
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LanguagePreference {
  SYSTEM
  EN
  FR
  ES
  PT_BR
  DE
  IT
  AR
  TR
  HI
  ID
  JA
  KO
  ZH_CN
}

enum CommentThreadType {
  SHOW
  MOVIE
  EPISODE
  GROUP
}

enum ReportReason {
  SPAM
  ABUSE
  OFF_TOPIC
  INAPPROPRIATE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  COMMENT
  IMAGE
  USER
}

// ---------------------------------------------------------------------------
// USERS / AUTH
// ---------------------------------------------------------------------------

model User {
  id                    String           @id @default(cuid())
  email                 String           @unique
  username              String           @unique
  passwordHash          String?
  role                  Role             @default(USER)
  isSuspended           Boolean          @default(false) @map("is_suspended")
  // Synthetic identity for imported third-party comments (author not a real user).
  isShadow              Boolean          @default(false) @map("is_shadow")
  emailVerified         Boolean          @default(false)
  mustChangePassword    Boolean          @default(false) @map("must_change_password")
  onboardingStatus      OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingVersion     Int?             @map("onboarding_version")
  onboardingCompletedAt DateTime?        @map("onboarding_completed_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  profile               UserProfile?
  authProviders         UserAuthProvider[]
  devices               Device[]
  showStatuses          UserShowStatus[]
  episodeStatuses       UserEpisodeStatus[]
  movieStatuses         UserMovieStatus[]
  watchHistory          WatchHistory[]
  watchlist             WatchlistItem[]
  favorites             Favorite[]
  ratings               Rating[]
  reactions             Reaction[]
  characterVotes        CharacterVote[]
  lists                 CustomList[]
  comments              Comment[]
  commentLikes          CommentLike[]
  commentSpoilerReports CommentSpoilerReport[]
  externalReviewLikes   ExternalReviewLike[]
  notifications         Notification[]
  notificationPrefs     NotificationPreference?
  providerAlerts        WatchProviderAlert[]
  badges                UserBadge[]
  imports               Import[]
  followsInitiated      Follow[]                @relation("FollowFollower")
  followsReceived       Follow[]                @relation("FollowTarget")
  activityFeed          Activity[]
  blocksInitiated       Block[]                 @relation("BlockBlocker")
  blocksReceived        Block[]                 @relation("BlockBlocked")
  reportsFiled          Report[]                @relation("ReportReporter")
  reportsAgainst        Report[]                @relation("ReportTarget")
  listLikes             ListLike[]
  listSubs              ListSubscription[]      @relation("ListSubUser")
  statsSummary          UserStatsSummary?
  statsSnapshots        UserStatsSnapshot[]
  contactThreads        ContactThread[]         @relation("ContactThreads")

  @@map("users")
}

model UserProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique @map("user_id")
  displayName           String?            @map("display_name")
  bio                   String?            @db.Text
  avatarUrl             String?            @map("avatar_url")
  coverUrl              String?            @map("cover_url")
  location              String?
  isPrivate             Boolean            @default(false) @map("is_private")
  hideAnimeInExplore    Boolean            @default(false) @map("hide_anime_in_explore")
  exploreDefaultFilters Json?              @map("explore_default_filters")
  themePreference       ThemePreference    @default(SYSTEM) @map("theme_preference")
  languagePreference    LanguagePreference @default(SYSTEM) @map("language_preference")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserAuthProvider {
  id           String       @id @default(cuid())
  userId       String       @map("user_id")
  provider     AuthProvider
  providerUid  String       @map("provider_uid")
  accessToken  String?      @map("access_token")
  refreshToken String?      @map("refresh_token")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
  @@map("user_auth_providers")
}

model Device {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String
  appVersion String?  @map("app_version")
  timezone   String?
  pushP256dh String?  @map("push_p256dh")
  pushAuth   String?  @map("push_auth")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

model Follow {
  id         String   @id @default(cuid())
  followerId String   @map("follower_id")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  target   User @relation("FollowTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([followerId, targetId])
  @@index([targetId])
  @@map("follows")
}

model Block {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

// ---------------------------------------------------------------------------
// MEDIA METADATA
// ---------------------------------------------------------------------------

model MediaItem {
  id                       String                @id @default(cuid())
  type                     MediaType
  title                    String
  normalizedTitle          String                @default(dbgenerated()) @map("normalized_title")
  overview                 String?               @db.Text
  popularity               Float                 @default(0)
  rating                   Float?
  status                   MediaStatus?
  trailerUrl               String?               @map("trailer_url")
  // denormalized image set cached from Image
  posterUrl                String?               @map("poster_url")
  backdropUrl              String?               @map("backdrop_url")
  logoUrl                  String?               @map("logo_url")
  stillUrl                 String?               @map("still_url")
  // Per-locale overrides for localized metadata (JSON: { "fr": "...", "es": "..." }).
  // Base columns above are the English fallback; titleLocale marks the base locale
  // ('en' = trusted) so hydrates never overwrite another user's language.
  titles                   Json?                 @map("titles")
  overviews                Json?                 @map("overviews")
  posterUrls               Json?                 @map("poster_urls")
  backdropUrls             Json?                 @map("backdrop_urls")
  titleLocale              String?               @map("title_locale")
  // match signal for "for you" scoring
  addedCount               Int                   @default(0) @map("added_count")
  metadataRefreshedAt      DateTime?             @map("metadata_refreshed_at")
  // Last time TMDB reviews were synced for this media (null = never).
  reviewsSyncedAt          DateTime?             @map("reviews_synced_at")
  // TMDB /recommendations snapshot (card-shaped: tmdbId, type, title, poster, year, rating).
  recommendations          Json?
  recommendationsSyncedAt  DateTime?             @map("recommendations_synced_at")
  // Normalized TMDB watch/providers offers keyed by ISO 3166-1 country:
  // { "US": { link, stream: [{name,logoUrl}], rent: [...], buy: [...] } }.
  // Written only when the hydrating provider supplies offers — TVDB never clobbers it.
  watchProviders           Json?                 @map("watch_providers_data")
  // Content classification (independent of structural type) + evidence model.
  contentClassification    ContentClassification @default(GENERAL) @map("content_classification")
  classificationConfidence Float                 @default(0) @map("classification_confidence")
  classificationTier       String?               @map("classification_tier") // candidate|probable|confirmed|unknown
  classifiedAt             DateTime?             @map("classified_at")
  classificationEvidence   Json?                 @map("classification_evidence")
  manualClassification     Boolean               @default(false) @map("manual_classification")
  manualCandidate          Boolean               @default(false) @map("manual_candidate")
  // Field-level metadata provenance: { title:{provider,at}, overview:{…}, … }
  metadataProvenance       Json?                 @map("metadata_provenance")
  createdAt                DateTime              @default(now()) @map("created_at")
  updatedAt                DateTime              @updatedAt @map("updated_at")

  show             Show?
  movie            Movie?
  externalIds      ExternalId[]
  images           Image[]
  genres           MediaGenre[]
  tags             MediaItemTag[]
  providers        MediaWatchProvider[]
  cast             MediaCast[]
  castExternalIds  MediaCastExternalId[]
  characterVotes   CharacterVote[]
  snapshots        MediaProviderSnapshot[]
  showStatuses     UserShowStatus[]
  movieStatuses    UserMovieStatus[]
  watchlist        WatchlistItem[]
  favorites        Favorite[]
  watchHistory     WatchHistory[]
  lists            CustomListItem[]
  externalReviews  ExternalReview[]
  providerAlerts   WatchProviderAlert[]
  titleAliases     MediaTitleAlias[]
  canonicalSource  MediaCanonicalLink?     @relation("MediaCanonicalSource")
  canonicalAliases MediaCanonicalLink[]    @relation("MediaCanonicalTarget")

  @@index([type])
  @@index([type, popularity(sort: Desc)], map: "media_items_type_popularity_idx")
  @@index([type, normalizedTitle], map: "media_items_type_normalized_title_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "media_items_title_trgm_idx")
  @@index([status])
  @@map("media_items")
}

// A source media row is hidden/redirected only when this link reaches ACTIVE. COPYING and
// FAILED links deliberately leave the source visible so a partial copy can never make user
// data disappear from normal queries. Source rows and their original user data are retained.
model MediaCanonicalLink {
  id                 String                 @id @default(cuid())
  sourceMediaId      String                 @unique @map("source_media_id")
  targetMediaId      String                 @map("target_media_id")
  relation           MediaCanonicalRelation
  targetSeasonNumber Int?                   @map("target_season_number")
  status             MediaCanonicalStatus   @default(COPYING)
  evidence           Json?
  copyReport         Json?                  @map("copy_report")
  lastError          String?                @map("last_error") @db.Text
  activatedAt        DateTime?              @map("activated_at")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  source MediaItem            @relation("MediaCanonicalSource", fields: [sourceMediaId], references: [id], onDelete: Cascade)
  target MediaItem            @relation("MediaCanonicalTarget", fields: [targetMediaId], references: [id], onDelete: Cascade)
  copies MediaCanonicalCopy[]

  @@index([targetMediaId, status])
  @@index([status, updatedAt])
  @@map("media_canonical_links")
}

// Idempotency and audit ledger for every copied source row. EPISODE entries also provide
// permanent old-episode URL/import redirects after the canonical link becomes ACTIVE.
model MediaCanonicalCopy {
  id         String   @id @default(cuid())
  linkId     String   @map("link_id")
  entityType String   @map("entity_type")
  sourceId   String   @map("source_id")
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")

  link MediaCanonicalLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@unique([linkId, entityType, sourceId])
  @@index([entityType, sourceId])
  @@index([entityType, targetId])
  @@map("media_canonical_copies")
}

// Searchable projection of MediaItem.titles. A database trigger keeps this table in sync so
// imports can use an indexed localized-title lookup instead of scanning every JSON document.
model MediaTitleAlias {
  mediaId         String @map("media_id")
  locale          String
  title           String
  normalizedTitle String @default(dbgenerated()) @map("normalized_title")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([mediaId, locale])
  @@index([normalizedTitle], map: "media_title_aliases_normalized_title_idx")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "media_title_aliases_title_trgm_idx")
  @@map("media_title_aliases")
}

model Show {
  id                   String             @id @default(cuid())
  mediaId              String             @unique @map("media_id")
  yearStart            Int?               @map("year_start")
  yearEnd              Int?               @map("year_end")
  network              String?
  runtimeMinutes       Int?               @map("runtime_minutes")
  nextAirDate          DateTime?          @map("next_air_date")
  seasonsCount         Int                @default(0) @map("seasons_count")
  episodesCount        Int                @default(0) @map("episodes_count")
  inProduction         Boolean            @default(false) @map("in_production")
  originalLanguage     String?            @map("original_language")
  // Original-language title (e.g. Japanese for anime) — displayed in show details only.
  originalTitle        String?            @map("original_title")
  originCountries      String[]           @map("origin_countries")
  totalRuntimeMinutes  Int?               @map("total_runtime_minutes")
  // TMDB keyword names (e.g. ["anime","isekai"]) — feeds the anime classifier.
  keywords             Json?
  structureProvider    StructureProvider? @map("structure_provider")
  structureReason      StructureReason?   @map("structure_reason")
  structureRuleVersion Int?               @map("structure_rule_version")
  structureDecidedAt   DateTime?          @map("structure_decided_at")

  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  seasons Season[]

  @@index([structureProvider])
  @@map("shows")
}

model Movie {
  id             String    @id @default(cuid())
  mediaId        String    @unique @map("media_id")
  releaseDate    DateTime? @map("release_date")
  releaseYear    Int?      @map("release_year")
  runtimeMinutes Int?      @map("runtime_minutes")
  country        String?
  language       String?
  budget         BigInt?
  // TMDB keyword names (e.g. ["anime"]) — feeds the anime classifier.
  keywords       Json?

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("movies")
}

model Season {
  id           String  @id @default(cuid())
  showId       String  @map("show_id")
  number       Int
  title        String
  overview     String? @db.Text
  posterUrl    String? @map("poster_url")
  episodeCount Int     @default(0) @map("episode_count")
  airedCount   Int     @default(0) @map("aired_count")
  isSpecial    Boolean @default(false) @map("is_special")
  // Per-locale overrides (base columns are the English fallback).
  titles       Json?   @map("titles")
  overviews    Json?   @map("overviews")
  posterUrls   Json?   @map("poster_urls")

  show     Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  episodes Episode[]

  @@unique([showId, number])
  @@index([showId])
  @@map("seasons")
}

model Episode {
  id              String                @id @default(cuid())
  seasonId        String                @map("season_id")
  number          Int
  absoluteNumber  Int?                  @map("absolute_number")
  title           String
  overview        String?               @db.Text
  stillUrl        String?               @map("still_url")
  runtimeMinutes  Int?                  @map("runtime_minutes")
  airDate         DateTime?             @map("air_date")
  airTime         String?               @map("air_time")
  rating          Float?
  isFinale        Boolean               @default(false) @map("is_finale")
  structureState  EpisodeStructureState @default(ACTIVE) @map("structure_state")
  // Per-locale overrides (base columns are the English fallback).
  titles          Json?                 @map("titles")
  overviews       Json?                 @map("overviews")
  stillUrls       Json?                 @map("still_urls")
  // Last time TMDB reviews were synced for this episode (null = never).
  reviewsSyncedAt DateTime?             @map("reviews_synced_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  season          Season                    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userStatuses    UserEpisodeStatus[]
  watchHistory    WatchHistory[]
  ratings         Rating[]
  reactions       Reaction[]
  characterVotes  CharacterVote[]
  externalIds     EpisodeExternalId[]
  snapshots       EpisodeProviderSnapshot[]
  externalReviews ExternalReview[]

  // Provider remaps may temporarily hold an ACTIVE canonical row beside a foreign
  // ACTIVE row with the same S/E coordinates. The latter becomes LEGACY_UNMAPPED or
  // is deleted before the locked repair completes, so S/E is indexed but not unique.
  @@index([seasonId, number])
  @@index([seasonId])
  @@index([airDate])
  @@index([structureState])
  @@index([seasonId, structureState, airDate], map: "episodes_season_structure_air_idx")
  @@index([structureState, airDate], map: "episodes_structure_air_idx")
  @@map("episodes")
}

model ExternalId {
  id                 String             @id @default(cuid())
  mediaId            String             @map("media_id")
  provider           ExternalProvider
  providerEntityKind ProviderEntityKind @map("provider_entity_kind")
  value              String
  url                String?

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEntityKind, value])
  @@index([mediaId])
  @@map("external_ids")
}

// Provider-authored reviews (TMDB reviews) attached to a media (movie/show) or an
// episode. Synced during TMDB hydration (append_to_response=reviews) and lazily when a
// comments thread opens on a never-synced/stale target. Page-1 replace semantics: rows
// that vanish from the provider's first page are pruned.
model ExternalReview {
  id              String           @id @default(cuid())
  provider        ExternalProvider @map("provider")
  externalId      String           @map("external_id") // provider review id
  mediaId         String?          @map("media_id")
  episodeId       String?          @map("episode_id")
  author          String
  username        String?
  avatarUrl       String?          @map("avatar_url")
  rating          Float? // provider 1..10 scale, as given
  content         String           @db.Text
  language        String?
  translations    Json             @default("{}")
  url             String // canonical provider review URL (badge target)
  likesCount      Int              @default(0) @map("likes_count")
  reviewCreatedAt DateTime         @map("review_created_at")
  reviewUpdatedAt DateTime?        @map("review_updated_at")
  pulledAt        DateTime         @default(now()) @map("pulled_at")

  media    MediaItem?           @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  episode  Episode?             @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    ExternalReviewLike[]

  @@unique([provider, externalId])
  @@index([mediaId])
  @@index([episodeId])
  @@map("external_reviews")
}

// Likes on provider reviews (reviews act as first-class thread roots).
model ExternalReviewLike {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  externalReviewId String   @map("external_review_id")
  createdAt        DateTime @default(now()) @map("created_at")

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  review ExternalReview @relation(fields: [externalReviewId], references: [id], onDelete: Cascade)

  @@unique([userId, externalReviewId])
  @@index([externalReviewId])
  @@map("external_review_likes")
}

// Episode-level external identities (e.g. a TVDB episode id). Separate table = no
// polymorphic ownership + clean FK integrity. Unique by (provider, kind, value).
model EpisodeExternalId {
  id                 String             @id @default(cuid())
  episodeId          String             @map("episode_id")
  provider           ExternalProvider
  providerEntityKind ProviderEntityKind @default(EPISODE) @map("provider_entity_kind")
  value              String
  url                String?

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([provider, providerEntityKind, value])
  @@index([episodeId])
  @@map("episode_external_ids")
}

model Image {
  id        String  @id @default(cuid())
  mediaId   String  @map("media_id")
  kind      String // poster | backdrop | still | logo
  url       String
  width     Int?
  height    Int?
  isPrimary Boolean @default(false) @map("is_primary")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, kind])
  @@map("images")
}

model Genre {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  // Per-locale name overrides (base `name` is the English fallback).
  names Json?  @map("names")

  media MediaGenre[]

  @@map("genres")
}

model MediaGenre {
  id      String @id @default(cuid())
  mediaId String @map("media_id")
  genreId String @map("genre_id")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  genre Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([mediaId, genreId])
  @@index([genreId])
  @@map("media_genres")
}

/// Stable provider-independent facet (for example k-drama or true-crime).
model MediaTag {
  id   String @id @default(cuid())
  slug String @unique

  media MediaItemTag[]

  @@map("media_tags")
}

/// Derived tag assignment. Recomputed from normalized genres, keywords, language,
/// and country whenever provider metadata changes.
model MediaItemTag {
  mediaId     String   @map("media_id")
  tagId       String   @map("tag_id")
  ruleVersion Int      @default(1) @map("rule_version")
  derivedAt   DateTime @default(now()) @map("derived_at")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag   MediaTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@index([tagId, mediaId])
  @@map("media_item_tags")
}

model WatchProvider {
  id      String  @id @default(cuid())
  name    String  @unique
  slug    String  @unique
  logoUrl String? @map("logo_url")

  media MediaWatchProvider[]

  @@map("watch_providers")
}

enum ProviderOfferType {
  STREAM
  RENT
  BUY
}

/// User opt-in: "notify me when this media becomes available on these providers".
/// One row per (user, media, offer type); providerIds empty = any provider.
/// One-shot: the daily check disables the row after notifying (no repeat spam).
model WatchProviderAlert {
  id          String            @id @default(cuid())
  userId      String            @map("user_id")
  mediaId     String            @map("media_id")
  offerType   ProviderOfferType @map("offer_type")
  /// ISO 3166-1 country whose offers are matched (resolved from the user's locale at subscribe time).
  country     String
  /// TMDB provider ids to match; empty array = notify on ANY provider appearing.
  providerIds Int[]             @map("provider_ids")
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  notifiedAt  DateTime?         @map("notified_at")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId, offerType])
  @@index([active])
  @@map("watch_provider_alerts")
}

/// Regional watch-provider catalog synced from TMDB /watch/providers/{movie,tv}
/// per region — powers the alert picker's provider list for the user's country.
model WatchProviderCatalog {
  id              String  @id @default(cuid())
  tmdbId          Int     @map("tmdb_id")
  name            String
  logoUrl         String? @map("logo_url")
  country         String
  displayPriority Int     @map("display_priority")

  @@unique([tmdbId, country])
  @@index([country])
  @@map("watch_provider_catalog")
}

model MediaWatchProvider {
  id         String  @id @default(cuid())
  mediaId    String  @map("media_id")
  providerId String  @map("provider_id")
  country    String  @default("US")
  link       String?

  media    MediaItem     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  provider WatchProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([mediaId, providerId, country])
  @@index([mediaId])
  @@map("media_watch_providers")
}

model CastMember {
  id              String    @id @default(cuid())
  name            String
  profileUrl      String?   @map("profile_url")
  externalId      String?   @unique @map("external_id")
  // Provider-namespaced person ids, resolved on first person-page view. Plain
  // indexes (not unique): duplicate members heal over time via merge-on-view.
  tmdbId          Int?      @map("tmdb_id")
  tvdbId          Int?      @map("tvdb_id")
  imdbId          String?   @map("imdb_id")
  // Details cache — English base columns; per-locale overrides in the JSON maps
  // (same base+override invariant as MediaItem.titles/overviews).
  birthDate       DateTime? @map("birth_date") @db.Date
  deathDate       DateTime? @map("death_date") @db.Date
  birthPlace      String?   @map("birth_place")
  biography       String?   @db.Text
  names           Json?
  biographies     Json?
  // App locales already attempted for details/credits (prevents refetch loops when
  // the provider lacks a locale — the media pipeline's locale-parking equivalent).
  detailsLocales  Json?     @map("details_locales")
  detailsSyncedAt DateTime? @map("details_synced_at")
  // Acting-credits snapshot (PersonCreditsSnapshot: items + per-locale title maps).
  credits         Json?
  creditsSyncedAt DateTime? @map("credits_synced_at")

  mediaCast MediaCast[]

  @@index([tmdbId])
  @@index([tvdbId])
  @@map("cast_members")
}

model MediaCast {
  id                  String  @id @default(cuid())
  mediaId             String  @map("media_id")
  castMemberId        String  @map("cast_member_id")
  character           String?
  /// Title-specific TVDB role artwork. CastMember.profileUrl remains the person's portrait.
  characterImageUrl   String? @map("character_image_url")
  sortOrder           Int     @map("sort_order")
  seasonNumber        Int?    @map("season_number")
  /// TVDB character id of this role — enables local resolution of TVTime character votes.
  characterExternalId Int?    @map("character_external_id")

  media          MediaItem             @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  castMember     CastMember            @relation(fields: [castMemberId], references: [id], onDelete: Cascade)
  // Per-locale character-name overrides (base `character` is the English fallback).
  characters     Json?                 @map("characters")
  characterVotes CharacterVote[]
  externalIds    MediaCastExternalId[]

  // One credit row per (media, person). The accompanying migration re-points votes
  // off exact duplicates before creating the index; cross-person duplicates (same
  // human under two provider ids) are merged by the cast-dedup repair job first.
  @@unique([mediaId, castMemberId])
  @@index([mediaId])
  @@index([mediaId, characterExternalId])
  @@map("media_cast")
}

// Provider role aliases scoped to one title. TVDB character ids are globally role-level,
// but a synthetic TV Time series role may legitimately be mapped onto several movies in a
// numbered film group, so identity is unique per media rather than globally.
model MediaCastExternalId {
  id       String           @id @default(cuid())
  mediaId  String           @map("media_id")
  castId   String           @map("cast_id")
  provider ExternalProvider
  value    String

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  cast  MediaCast @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@unique([mediaId, provider, value])
  @@index([castId])
  @@map("media_cast_external_ids")
}

// Provider response cache/audit snapshot scoped to a media row (single required FK owner).
model MediaProviderSnapshot {
  id                 String             @id @default(cuid())
  mediaId            String             @map("media_id")
  provider           ExternalProvider
  providerEntityKind ProviderEntityKind @map("provider_entity_kind")
  kind               String // e.g. 'series_extended' | 'movie_extended' | 'anime' | 'manga'
  locale             String?
  payload            Json
  fetchedAt          DateTime           @default(now()) @map("fetched_at")
  expiresAt          DateTime           @map("expires_at")

  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, provider, providerEntityKind, kind, locale])
  @@index([mediaId])
  @@map("media_provider_snapshots")
}

// Provider response cache/audit snapshot scoped to an episode row.
model EpisodeProviderSnapshot {
  id                 String             @id @default(cuid())
  episodeId          String             @map("episode_id")
  provider           ExternalProvider
  providerEntityKind ProviderEntityKind @default(EPISODE) @map("provider_entity_kind")
  kind               String
  locale             String?
  payload            Json
  fetchedAt          DateTime           @default(now()) @map("fetched_at")
  expiresAt          DateTime           @map("expires_at")

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, provider, providerEntityKind, kind, locale])
  @@index([episodeId])
  @@map("episode_provider_snapshots")
}

// ---------------------------------------------------------------------------
// USER MEDIA DATA
// ---------------------------------------------------------------------------

model UserShowStatus {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  mediaId       String    @map("media_id")
  watchedCount  Int       @default(0) @map("watched_count")
  totalCount    Int       @default(0) @map("total_count")
  lastWatchedAt DateTime? @map("last_watched_at")
  /// Explicit Dropped library state. The watchlist row, history, and progress are
  /// preserved while the show is hidden from watch-next/upcoming/notifications.
  /// Watching an episode does NOT clear it; only an explicit restore does.
  dropped       Boolean   @default(false) @map("dropped")
  /// Set when the user pauses tracking — hidden from watch-next/upcoming and no
  /// episode/watchlist notifications, while watch history and progress are kept.
  /// Unlike `dropped`, watching an episode does NOT clear it (imports would
  /// silently unpause everything); only the explicit resume action clears it.
  pausedAt      DateTime? @map("paused_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([userId, dropped, pausedAt, lastWatchedAt], map: "user_show_status_library_idx")
  @@map("user_show_status")
}

model UserEpisodeStatus {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  episodeId  String       @map("episode_id")
  watched    Boolean      @default(false)
  watchedAt  DateTime?    @map("watched_at")
  /// How many times the user has watched this episode. Stays at 1 after the first
  /// watch and increments on each rewatch; reset to 0 on unwatch. watchedAt always
  /// holds the FIRST watch date and is never bumped by a rewatch.
  watchCount Int          @default(0) @map("watch_count")
  device     WatchDevice?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([userId, watched])
  @@index([episodeId])
  @@map("user_episode_status")
}

model UserMovieStatus {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  mediaId    String       @map("media_id")
  watched    Boolean      @default(false)
  watchedAt  DateTime?    @map("watched_at")
  watchCount Int          @default(0) @map("watch_count")
  device     WatchDevice?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([userId, watched, watchedAt], map: "user_movie_status_library_idx")
  @@map("user_movie_status")
}

model WatchHistory {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  mediaId        String    @map("media_id")
  mediaType      MediaType @map("media_type")
  episodeId      String?   @map("episode_id")
  seasonNumber   Int?      @map("season_number")
  episodeNumber  Int?      @map("episode_number")
  runtimeMinutes Int?      @map("runtime_minutes")
  watchedAt      DateTime  @map("watched_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode?  @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  media   MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
  @@index([userId, mediaId], map: "watch_history_user_media_idx")
  @@index([userId, mediaType, watchedAt, id], map: "watch_history_user_type_cursor_idx")
  @@index([mediaId])
  @@index([episodeId])
  @@map("watch_history")
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([userId, createdAt], map: "watchlist_items_user_created_idx")
  @@map("watchlist_items")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  mediaId   String   @map("media_id")
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId])
  @@index([userId, createdAt], map: "favorites_user_created_idx")
  @@map("favorites")
}

model Rating {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  mediaId   String?     @map("media_id")
  episodeId String?     @map("episode_id")
  rating    Int
  source    ListSource? @default(MANUAL) @map("source")
  sourceKey String?     @map("source_key")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@unique([userId, mediaId])
  @@index([mediaId])
  @@index([userId, source, sourceKey])
  @@map("ratings")
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  episodeId String?      @map("episode_id")
  mediaId   String?      @map("media_id")
  reaction  ReactionType
  source    ListSource?  @default(MANUAL) @map("source")
  sourceKey String?      @map("source_key")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime?    @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId, reaction])
  @@unique([userId, mediaId, reaction])
  @@index([episodeId])
  @@index([mediaId])
  @@index([userId, source, sourceKey])
  @@map("reactions")
}

model CharacterVote {
  id        String      @id @default(cuid())
  userId    String      @map("user_id")
  episodeId String?     @map("episode_id")
  mediaId   String?     @map("media_id")
  castId    String      @map("cast_id")
  source    ListSource? @default(MANUAL) @map("source")
  sourceKey String?     @map("source_key")
  createdAt DateTime    @default(now()) @map("created_at")

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode?   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  media   MediaItem? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  cast    MediaCast  @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@unique([userId, mediaId])
  @@index([episodeId])
  @@index([mediaId])
  @@index([castId])
  @@index([userId, source, sourceKey])
  @@map("character_votes")
}

// ---------------------------------------------------------------------------
// LISTS / COMMUNITY
// ---------------------------------------------------------------------------

model CustomList {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  title       String
  description String?        @db.Text
  coverUrl    String?        @map("cover_url")
  visibility  ListVisibility @default(PRIVATE)
  source      ListSource     @default(MANUAL) @map("source")
  sourceKey   String?        @map("source_key")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CustomListItem[]
  likes         ListLike[]
  subscriptions ListSubscription[]

  @@unique([userId, source, sourceKey])
  @@index([userId])
  @@map("custom_lists")
}

model CustomListItem {
  id        String   @id @default(cuid())
  listId    String   @map("list_id")
  mediaId   String   @map("media_id")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  list  CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  media MediaItem  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([listId, mediaId])
  @@index([listId])
  @@map("custom_list_items")
}

model ListLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  listId    String   @map("list_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  list CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@map("list_likes")
}

model ListSubscription {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  listId      String   @map("list_id")
  notifyOnAdd Boolean  @default(false) @map("notify_on_add")
  createdAt   DateTime @default(now()) @map("created_at")

  user User       @relation("ListSubUser", fields: [userId], references: [id], onDelete: Cascade)
  list CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, listId])
  @@map("list_subscriptions")
}

model Comment {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  parentId         String?           @map("parent_id")
  // Nesting level (0 = top-level) and top-level ancestor id (NULL for top-level),
  // maintained at creation time. Enables depth-limited subtree fetches.
  depth            Int               @default(0)
  rootId           String?           @map("root_id")
  threadType       CommentThreadType @map("thread_type")
  threadId         String            @map("thread_id")
  body             String            @db.Text
  imageUrl         String?           @map("image_url")
  gifUrl           String?           @map("gif_url")
  mediaType        MediaType?        @map("media_type")
  mediaId          String?           @map("media_id")
  listId           String?           @map("list_id")
  isSpoiler        Boolean           @default(false) @map("is_spoiler")
  // Spoiler-report tally (community flagging; isSpoiler flips at the threshold).
  spoilerCount     Int               @default(0) @map("spoiler_count")
  // Set when this comment replies to a provider review (TMDB review as parent).
  externalReviewId String?           @map("external_review_id")
  // Deferred parent identity (source_key of the parent's source comment). Set when an
  // imported reply's parent is not in our DB yet — linked once the parent arrives.
  parentSourceKey  String?           @map("parent_source_key")
  language         String?
  translations     Json              @default("{}")
  source           ListSource?       @default(MANUAL) @map("source")
  sourceKey        String?           @map("source_key")
  likesCount       Int               @default(0) @map("likes_count")
  repliesCount     Int               @default(0) @map("replies_count")
  hidden           Boolean           @default(false)
  adminDeleted     Boolean           @default(false) @map("admin_deleted")
  deletedByUser    Boolean           @default(false) @map("deleted_by_user")
  editedAt         DateTime?         @map("edited_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent         Comment?               @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies        Comment[]              @relation("CommentReplies")
  likes          CommentLike[]
  reports        Report[]
  spoilerReports CommentSpoilerReport[]
  externalReview ExternalReview?        @relation(fields: [externalReviewId], references: [id], onDelete: SetNull)
  image          CommentImage?

  @@index([threadType, threadId])
  @@index([userId])
  @@index([parentId])
  @@index([rootId])
  @@index([userId, source, sourceKey])
  @@index([parentSourceKey])
  @@index([externalReviewId])
  @@map("comments")
}

enum CommentImageStatus {
  pending
  uploaded
  validating
  moderating
  processing
  ready
  rejected
  failed
  deleted
  needs_manual_review
}

model CommentImage {
  id        String             @id @default(cuid())
  commentId String             @unique @map("comment_id")
  userId    String             @map("user_id")
  status    CommentImageStatus @default(pending)

  originalMimeType   String? @map("original_mime_type")
  detectedMimeType   String? @map("detected_mime_type")
  originalSizeBytes  Int?    @map("original_size_bytes")
  uploadedSizeBytes  Int?    @map("uploaded_size_bytes")
  processedSizeBytes Int?    @map("processed_size_bytes")
  thumbnailSizeBytes Int?    @map("thumbnail_size_bytes")

  width           Int?
  height          Int?
  thumbnailWidth  Int? @map("thumbnail_width")
  thumbnailHeight Int? @map("thumbnail_height")

  storageKey          String? @map("storage_key")
  thumbnailStorageKey String? @map("thumbnail_storage_key")
  tempStorageKey      String? @map("temp_storage_key")

  encryptionAlgorithm       String? @default("AES-256-GCM") @map("encryption_algorithm")
  encryptedDataKey          String? @map("encrypted_data_key")
  iv                        String?
  authTag                   String? @map("auth_tag")
  thumbnailEncryptedDataKey String? @map("thumbnail_encrypted_data_key")
  thumbnailIv               String? @map("thumbnail_iv")
  thumbnailAuthTag          String? @map("thumbnail_auth_tag")

  sha256Hash String? @map("sha256_hash")
  blurhash   String?

  moderationProvider       String?  @default("openai") @map("moderation_provider")
  moderationModel          String?  @map("moderation_model")
  moderationFlagged        Boolean? @map("moderation_flagged")
  moderationCategories     Json?    @map("moderation_categories")
  moderationCategoryScores Json?    @map("moderation_category_scores")
  moderationDecision       String?  @map("moderation_decision")
  rejectionReason          String?  @map("rejection_reason")
  errorMessage             String?  @map("error_message")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  processedAt DateTime? @map("processed_at")
  deletedAt   DateTime? @map("deleted_at")

  comment Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([userId])
  @@index([status])
  @@map("comment_images")
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

// Community spoiler flags: one row per (user, comment). `Comment.spoilerCount` is the
// tally; `Comment.isSpoiler` flips to true at the threshold (5).
model CommentSpoilerReport {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  commentId String   @map("comment_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_spoiler_reports")
}

model Report {
  id             String           @id @default(cuid())
  reporterId     String           @map("reporter_id")
  targetType     ReportTargetType @default(COMMENT) @map("target_type")
  commentId      String?          @map("comment_id")
  commentImageId String?          @map("comment_image_id")
  reportedUserId String?          @map("reported_user_id")
  reason         ReportReason
  status         ReportStatus     @default(OPEN)
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at")

  reporter     User          @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?         @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: SetNull)
  comment      Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentImage CommentImage? @relation(fields: [commentImageId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([targetType, status])
  @@index([reportedUserId])
  @@map("reports")
}

model Activity {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  text        String
  mediaTitle  String?  @map("media_title")
  mediaPoster String?  @map("media_poster")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("activity")
}

// ---------------------------------------------------------------------------
// IMPORTS
// ---------------------------------------------------------------------------

model Import {
  id                              String           @id @default(cuid())
  userId                          String           @map("user_id")
  sourceType                      ImportSourceType @default(zip) @map("source_type")
  format                          String           @default("tvtime") @map("format")
  originalFilename                String?          @map("original_filename")
  storageKey                      String?          @map("storage_key")
  status                          ImportStatus     @default(UPLOADED)
  totalFiles                      Int              @default(0) @map("total_files")
  totalRows                       Int              @default(0) @map("total_rows")
  // 0-100 processing progress, updated at stage transitions + per batch/section.
  progress                        Int              @default(0)
  matchedCount                    Int              @default(0) @map("matched_count")
  unmatchedCount                  Int              @default(0) @map("unmatched_count")
  duplicateCount                  Int              @default(0) @map("duplicate_count")
  conflictCount                   Int              @default(0) @map("conflict_count")
  invalidCount                    Int              @default(0) @map("invalid_count")
  needsReviewCount                Int              @default(0) @map("needs_review_count")
  ratingsDetected                 Int              @default(0) @map("ratings_detected")
  ratingsImported                 Int              @default(0) @map("ratings_imported")
  ratingsUpdated                  Int              @default(0) @map("ratings_updated")
  ratingsSkippedUnsupported       Int              @default(0) @map("ratings_skipped_unsupported")
  ratingsSkippedUnresolved        Int              @default(0) @map("ratings_skipped_unresolved")
  ratingDuplicatesIgnored         Int              @default(0) @map("rating_duplicates_ignored")
  emotionsDetected                Int              @default(0) @map("emotions_detected")
  emotionsImported                Int              @default(0) @map("emotions_imported")
  emotionsSkippedUnsupported      Int              @default(0) @map("emotions_skipped_unsupported")
  emotionsSkippedUnresolved       Int              @default(0) @map("emotions_skipped_unresolved")
  emotionDuplicatesIgnored        Int              @default(0) @map("emotion_duplicates_ignored")
  commentRowsDetected             Int              @default(0) @map("comment_rows_detected")
  topLevelCommentsDetected        Int              @default(0) @map("top_level_comments_detected")
  commentsImported                Int              @default(0) @map("comments_imported")
  commentRepliesSkipped           Int              @default(0) @map("comment_replies_skipped")
  commentActivityRowsSkipped      Int              @default(0) @map("comment_activity_rows_skipped")
  commentsByOtherUsersSkipped     Int              @default(0) @map("comments_by_other_users_skipped")
  commentsSkippedUnresolved       Int              @default(0) @map("comments_skipped_unresolved")
  commentDuplicatesIgnored        Int              @default(0) @map("comment_duplicates_ignored")
  commentsSkippedInvalid          Int              @default(0) @map("comments_skipped_invalid")
  characterVotesDetected          Int              @default(0) @map("character_votes_detected")
  characterVotesImported          Int              @default(0) @map("character_votes_imported")
  characterVotesSkippedUnresolved Int              @default(0) @map("character_votes_skipped_unresolved")
  characterVoteDuplicatesIgnored  Int              @default(0) @map("character_vote_duplicates_ignored")
  characterVotesSkippedInvalid    Int              @default(0) @map("character_votes_skipped_invalid")
  locale                          String?          @map("locale")
  // TV Time account id of the archive owner — enables claiming deterministic shadow
  // accounts (imported third-party comment authors) when the real user imports their data.
  ownerExternalId                 String?          @map("owner_external_id")
  errorMessage                    String?          @map("error_message")
  createdAt                       DateTime         @default(now()) @map("created_at")
  updatedAt                       DateTime         @updatedAt @map("updated_at")
  // When processing finished (reached READY_FOR_REVIEW) — drives "Succeeded in X".
  processedAt                     DateTime?        @map("processed_at")
  completedAt                     DateTime?        @map("completed_at")
  cancelledAt                     DateTime?        @map("cancelled_at")
  rolledBackAt                    DateTime?        @map("rolled_back_at")

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  files   ImportFile[]
  items   ImportItem[]
  logs    ImportLog[]
  applied ImportAppliedRecord[]

  @@index([userId])
  @@map("imports")
}

model ImportFile {
  id                 String            @id @default(cuid())
  importId           String            @map("import_id")
  filename           String
  detectedType       String            @default("csv") @map("detected_type")
  detectedEntityType ImportEntityType? @map("detected_entity_type")
  fileSizeBytes      Int               @default(0) @map("file_size_bytes")
  rowCount           Int               @default(0) @map("row_count")
  headers            Json?
  status             String            @default("pending")
  errorMessage       String?           @map("error_message")
  createdAt          DateTime          @default(now()) @map("created_at")

  import Import       @relation(fields: [importId], references: [id], onDelete: Cascade)
  items  ImportItem[]

  @@index([importId])
  @@map("import_files")
}

model ImportItem {
  id               String            @id @default(cuid())
  importId         String            @map("import_id")
  importFileId     String?           @map("import_file_id")
  rowNumber        Int               @default(0) @map("row_number")
  sourceEntityType ImportEntityType  @map("source_entity_type")
  targetEntityType ImportEntityType? @map("target_entity_type")
  status           ImportItemStatus  @default(UNMATCHED)
  rawData          Json              @map("raw_data")
  normalizedData   Json?             @map("normalized_data")
  matchedMediaId   String?           @map("matched_media_id")
  matchedEpisodeId String?           @map("matched_episode_id")
  confidenceScore  Float             @default(0) @map("confidence_score")
  userResolution   String?           @map("user_resolution")
  errorMessage     String?           @map("error_message")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  import Import      @relation(fields: [importId], references: [id], onDelete: Cascade)
  file   ImportFile? @relation(fields: [importFileId], references: [id], onDelete: SetNull)

  @@index([importId])
  @@index([importId, status])
  @@index([matchedMediaId])
  @@map("import_items")
}

model ImportLog {
  id        String   @id @default(cuid())
  importId  String   @map("import_id")
  level     String   @default("info")
  message   String
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("import_logs")
}

model ImportAppliedRecord {
  id             String              @id @default(cuid())
  importId       String              @map("import_id")
  importItemId   String?             @map("import_item_id")
  targetTable    String              @map("target_table")
  targetRecordId String              @map("target_record_id")
  action         ImportAppliedAction
  previousData   Json?               @map("previous_data")
  newData        Json?               @map("new_data")
  createdAt      DateTime            @default(now()) @map("created_at")

  import Import @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("import_applied_records")
}

